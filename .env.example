# DESENVOLVIMENTO LOCAL (opcional)
REFRAO_SERVER_PORT=4010

# CORS. Em deploy único no Render, pode deixar *.
# Se separar frontend/backend, use a URL do Netlify, ex.:
# REFRAO_ALLOWED_ORIGINS=https://seu-site.netlify.app
REFRAO_ALLOWED_ORIGINS=*

# Somente para build do frontend SE ele ficar em outro domínio (ex.: Netlify).
# VITE_SERVER_URL=https://seu-backend.onrender.com

# Opcional: expande o catálogo consultando a Deezer em segundo plano.
# No Render gratuito, mantenha desligado para cold start e navegação mais rápidos.
# REFRAO_BACKGROUND_CATALOG_EXPANSION=true
